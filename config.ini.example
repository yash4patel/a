[CSV FILE INPUT]
account = /path/to/account_reference.csv
party = /path/to/party_reference.csv
achodfi = /path/to/achodfi_reference.csv
retail = /path/to/retail_reference.csv
business = /path/to/business_reference.csv

[CROSS-CHANNEL]
ach_dir = /path/to/ach/files
check_dir = /path/to/check/xml
wire_dir = /path/to/wire/logs
ach_glob = *ACH,*ach
check_glob = *.xml,*.XML
wire_glob = **/*.log,**/*.LOG

[SCHEMA]
json_schema_file = /path/to/jsonFileConfig.json

[OUTPUT]
output_dir = /path/to/output

[GENERAL]
tenant_name = ExampleTenant

[OPTIONS]
cross_check_party = true
cross_check_achodfi_party = true
cross_check_business_party = true
cross_check_retail_party = true
cross_check_ach = true
cross_check_check = true
cross_check_wire = true
strip_leading_zeros = true
