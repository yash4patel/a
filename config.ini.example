[GENERAL]
# Choose which validation to run: "x937" or "xml"
validation_type = x937

# Enable/disable console output
verbose_output = true

# ============================================================
# DATA CONFIGURATION
# ============================================================
[DATA]
# Input directory (works for both X937 and XML files)
input_path = /mounts/customer-data/RepublicBankAndTrustCompanyKY-Check_5906/testing_dir/ocontreras/test2/transformer_archive/

# Number of sample days to process (0 = all files)
sample_days = 7

# Tenant name for output files
tenant_name = RepublicBankAndTrustCompanyKY

# ============================================================
# ROUTING CONFIGURATION (CRITICAL - MUST BE CONSISTENT)
# ============================================================
[X937]
# Bank ABA/routing number(s) - supports comma-separated list
# Examples:
#   Single ABA:   our_aba = 083001314
#   Multiple ABAs: our_aba = 083001314,021000021,026009593
our_aba = 083001314

# ============================================================
# VALIDATION SETTINGS (UNIFIED ACROSS BOTH FORMATS)
# ============================================================
[VALIDATION]
# FAIL if bad_record_percentage > this value
# Applies to X937 syntax checks and XML parsing errors
bad_record_threshold = 5.0

# Amount validation
allow_zero_amount = false
allow_missing_amount = false

# ON_US structure validation
# WARN if slash-separated element count >= this value
onus_max_elements = 3

# Duplicate check detection
enable_duplicate_check = true

# Settlement date validation
enable_date_continuity = true

# Outlier detection
enable_outlier_detection = true
iqr_multiplier = 3.0

# Sequence number validation (X937 only)
enable_sequence_check = true

[LOGGING]
# Log file is auto-generated by tenant + timestamp:
# {tenant_name}_{timestamp}.{X937|XML}.log
